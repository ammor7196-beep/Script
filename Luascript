-- Логика полета и Noclip
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local flying = false
local flySpeed = 50
local bv, bg
local noclipConnection

function startFlying()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then humanoid.PlatformStand = true end
    
    bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = hrp.CFrame
    bg.Parent = hrp
    
    bv = Instance.new("BodyVelocity")
    bv.velocity = Vector3.new(0, 0.1, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = hrp
    
    -- Исправленный Noclip для мобильных устройств
    noclipConnection = RunService.Stepped:Connect(function()
        if flying and character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)
    
    -- Цикл полета (направление по джойстику + камере)
    local camera = workspace.CurrentCamera
    spawn(function()
        while flying and character and hrp.Parent do
            RunService.RenderStepped:Wait()
            local direction = Vector3.new(0, 0, 0)
            
            if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                direction = humanoid.MoveDirection
            end
            
            bv.velocity = direction * flySpeed
            bg.cframe = camera.CFrame
        end
    end)
end

function stopFlying()
    flying = false
    if noclipConnection then noclipConnection:Disconnect() end
    
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
        end
    end
end

-- ИСПРАВЛЕНИЕ НАЖАТИЙ ДЛЯ ТЕЛЕФОНА (Используем Activated вместо MouseButton1Click)
ToggleButton.Activated:Connect(function()
    flying = not flying
    if flying then
        ToggleButton.Text = "Полет: ВКЛ"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        startFlying()
    else
        ToggleButton.Text = "Полет: ВЫКЛ"
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        stopFlying()
    end
end)

-- Скрытие / Показ меню по нажатию на кнопку GUI (тоже через Activated)
