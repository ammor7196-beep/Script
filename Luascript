local Fluent = loadstring(game:HttpGet("https://github.com"))()

-- Создаем окно чита
local Window = Fluent:CreateWindow({
    Title = "Mobile Fly & Noclip",
    SubTitle = "by AI Assistant",
    TabWidth = 140,
    Size = UDim2.fromOffset(450, 280),
    Acrylic = false,
    Theme = "Dark",
    MinimizeKey = Enum.KeyCode.LeftControl
})

-- Добавляем вкладку с функциями
local Tabs = {
    Main = Window:AddTab({ Title = "Функции", Icon = "home" })
}

-- Глобальные переменные для работы функций
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local flying = false
local noclip = false
local flySpeed = 50
local bv, bg
local noclipConnection

-- Логика полета по направлению камеры
local function startFlying()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then humanoid.PlatformStand = true end
    
    bg = Instance.new("BodyGyro")
    bg.P = 9e4
    bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
    bg.cframe = hrp.CFrame
    bg.Parent = hrp
    
    bv = Instance.new("BodyVelocity")
    bv.velocity = Vector3.new(0, 0.1, 0)
    bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Parent = hrp
    
    local camera = workspace.CurrentCamera
    task.spawn(function()
        while flying and character and hrp.Parent do
            RunService.RenderStepped:Wait()
            local direction = Vector3.new(0, 0, 0)
            if humanoid and humanoid.MoveDirection.Magnitude > 0 then
                local layoutRotation = math.atan2(-humanoid.MoveDirection.X, -humanoid.MoveDirection.Z)
                local cameraRotation = math.atan2(-camera.CFrame.LookVector.X, -camera.CFrame.LookVector.Z)
                local finalRotation = layoutRotation - cameraRotation
                direction = (camera.CFrame * CFrame.Angles(0, finalRotation, 0)).LookVector
            end
            bv.velocity = direction * flySpeed
            bg.cframe = camera.CFrame
        end
    end)
end

local function stopFlying()
    flying = false
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then humanoid.PlatformStand = false end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
        end
    end
end

-- Логика Ноуклипа (сквозь стены)
noclipConnection = RunService.Stepped:Connect(function()
    if noclip then
        local character = LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- НАСТРОЙКА ЭЛЕМЕНТОВ МЕНЮ --

-- 1. Переключатель FLY (Полет)
local FlyToggle = Tabs.Main:AddToggle("FlyToggle", {Title = "Включить Полет (Fly)", Default = false})
FlyToggle:OnChanged(function(Value)
    flying = Value
    if flying then
        startFlying()
    else
        stopFlying()
    end
end)

-- 2. Поле ввода скорости (Input)
local SpeedInput = Tabs.Main:AddInput("SpeedInput", {
    Title = "Скорость полета",
    Default = "50",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            flySpeed = num
        end
    end
})

-- 3. Переключатель NOCLIP (Сквозь стены)
local NoclipToggle = Tabs.Main:AddToggle("NoclipToggle", {Title = "Сквозь стены (Noclip)", Default = false})
NoclipToggle:OnChanged(function(Value)
    noclip = Value
end)

-- Авто-сброс при перезагрузке персонажа (смерти)
LocalPlayer.CharacterAdded:Connect(function()
    flying = false
    noclip = false
    FlyToggle:SetValue(false)
    NoclipToggle:SetValue(false)
end)

Window:SelectTab(1)
